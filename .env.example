# PostgreSQL is the source of truth. Never commit a real credential.
DATABASE_URL=postgresql://cce:cce@localhost:5432/cce

# OpenAI-compatible Qwen/vLLM endpoint. The key may be a local placeholder only
# when the selected runtime explicitly does not authenticate requests.
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_API_KEY=
MODEL_CHAT_MODEL=Qwen/Qwen3-8B
MODEL_EXTRACTOR_MODEL=Qwen/Qwen3-8B
MODEL_CLASSIFIER_MODEL=Qwen/Qwen3-4B
MODEL_RESOLVER_MODEL=Qwen/Qwen3-32B
MODEL_REQUEST_TIMEOUT_MS=30000

# Development bootstrap values consumed by `pnpm db:seed`. Set unique values.
CCE_SEED_USER_EMAIL=alice@example.test
CCE_SEED_USER_NAME=Alice
CCE_SEED_API_TOKEN=replace-with-a-random-development-token

# Used to encrypt/sign server-side session state. Generate at least 32 random bytes.
CCE_SESSION_SECRET=replace-with-at-least-32-random-bytes

