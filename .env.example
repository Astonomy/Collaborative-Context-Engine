# Local Web and database CLI commands automatically load this root file without
# replacing values already present in process.env. Never use it as a production
# secret source or commit a real credential.
DATABASE_URL=postgresql://cce:replace-with-local-password@localhost:5432/cce
# Maintenance database used only to create/drop isolated cce_test_* databases.
# The role needs CREATEDB locally. Never point this at the normal cce database.
TEST_DATABASE_URL=postgresql://cce:replace-with-local-password@localhost:5432/postgres

# OpenAI-compatible Qwen/vLLM endpoint. The key may be a local placeholder only
# when the selected runtime explicitly does not authenticate requests.
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_API_KEY=
MODEL_CHAT_MODEL=Qwen/Qwen3-8B
MODEL_EXTRACTOR_MODEL=Qwen/Qwen3-8B
MODEL_CLASSIFIER_MODEL=Qwen/Qwen3-4B
MODEL_RESOLVER_MODEL=Qwen/Qwen3-32B
MODEL_REQUEST_TIMEOUT_MS=30000

# Development bootstrap values consumed by `pnpm db:seed`. Set unique values.
CCE_SEED_USER_EMAIL=alice@example.test
CCE_SEED_USER_NAME=Alice
CCE_SEED_API_TOKEN=replace-with-a-random-development-token

# Client-side local Codex connector credential. Set it only in the environment
# of the process launching Codex; the CCE Web process does not consume it.
CCE_MCP_ACCESS_TOKEN=

# Used to encrypt/sign server-side session state. Generate at least 32 random bytes.
CCE_SESSION_SECRET=replace-with-at-least-32-random-bytes
