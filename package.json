{
  "name": "collaborative-context-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "pnpm build:api && pnpm build:frontend",
    "clean": "node scripts/clean.mjs",
    "db:migrate": "pnpm --filter @cce/database migrate",
    "db:seed": "pnpm --filter @cce/database seed",
    "dev": "node scripts/dev-standalone.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "start": "pnpm start:api",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tools.json --noEmit --pretty false && tsc -p apps/api/tsconfig.json --pretty false && pnpm --filter @cce/web typecheck && pnpm --filter @cce/vue typecheck",
    "test": "vitest run && pnpm --filter @cce/vue test && pnpm test:plugin",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && pnpm --filter @cce/vue test:coverage && pnpm test:plugin",
    "test:integration": "node --import ./scripts/load-root-environment.mts --import tsx ./scripts/run-postgres-tests.mts integration",
    "test:e2e": "node --import ./scripts/load-root-environment.mts --import tsx ./scripts/run-postgres-tests.mts e2e",
    "test:e2e:vue": "node --import ./scripts/load-root-environment.mts --import tsx ./scripts/run-postgres-tests.mts vue",
    "test:e2e:attachments": "node --import ./scripts/load-root-environment.mts --import tsx ./scripts/run-postgres-tests.mts attachments",
    "test:performance": "node --import tsx scripts/compare-frontends.mts",
    "verify:browser-bundles": "node --import ./scripts/load-root-environment.mts scripts/audit-browser-bundles.mjs",
    "verify:local": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && node scripts/report-local-gate.mjs",
    "verify:full": "pnpm verify:local && pnpm test:integration && pnpm test:e2e && pnpm test:e2e:vue && pnpm test:e2e:standalone && pnpm test:e2e:decoupling",
    "validate": "pnpm verify:local",
    "dev:api": "node --import ./scripts/load-root-environment.mts --import tsx apps/api/main.ts",
    "dev:standalone": "node scripts/dev-standalone.mjs",
    "dev:vue": "pnpm --filter @cce/vue dev",
    "test:plugin": "node --test plugins/cce-conversation-submission/scripts/*.test.mjs",
    "build:legacy": "tsc -b --pretty false && pnpm --filter @cce/vue build && node scripts/stage-vue.mjs && pnpm --filter @cce/web build && node scripts/stage-web-runtime.mjs",
    "build:api": "node scripts/clean.mjs --api && tsc -b --pretty false && tsc -p apps/api/tsconfig.build.json --pretty false",
    "build:frontend": "node scripts/clean.mjs --frontend && pnpm --filter @cce/vue typecheck && node scripts/frontend.mjs build",
    "dev:frontend": "node scripts/frontend.mjs dev",
    "dev:legacy": "node scripts/dev.mjs",
    "start:legacy": "pnpm --filter @cce/web start",
    "start:api": "node --import ./scripts/load-root-environment.mts --import tsx apps/api/dist/apps/api/main.js",
    "test:e2e:standalone": "node --import ./scripts/load-root-environment.mts --import tsx ./scripts/run-postgres-tests.mts attachments",
    "verify:frontend": "node scripts/audit-browser-bundles.mjs --vue-only",
    "test:e2e:decoupling": "node --import ./scripts/load-root-environment.mts --import tsx ./scripts/run-postgres-tests.mts decoupling"
  },
  "devDependencies": {
    "@cce/agents": "workspace:*",
    "@cce/api-contracts": "workspace:*",
    "@cce/application": "workspace:*",
    "@cce/context-engine": "workspace:*",
    "@cce/conversation-import": "workspace:*",
    "@cce/database": "workspace:*",
    "@cce/domain": "workspace:*",
    "@cce/mcp-server": "workspace:*",
    "@cce/model-provider": "workspace:*",
    "@cce/shared": "workspace:*",
    "@cce/storage": "workspace:*",
    "@cce/test-support": "workspace:*",
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.62.1",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11",
    "zod": "4.4.3",
    "@cce/server-runtime": "workspace:*"
  }
}
