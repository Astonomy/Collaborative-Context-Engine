{
  "name": "collaborative-context-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "tsc -b --pretty false && pnpm --filter @cce/web build",
    "clean": "node scripts/clean.mjs",
    "db:migrate": "pnpm --filter @cce/database migrate",
    "db:seed": "pnpm --filter @cce/database seed",
    "dev": "pnpm --filter @cce/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "start": "pnpm --filter @cce/web start",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tools.json --noEmit --pretty false && pnpm --filter @cce/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node --import ./scripts/load-root-environment.mts --import tsx ./scripts/run-postgres-tests.mts integration",
    "test:e2e": "node --import ./scripts/load-root-environment.mts --import tsx ./scripts/run-postgres-tests.mts e2e",
    "verify:local": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && node scripts/report-local-gate.mjs",
    "verify:full": "pnpm verify:local && pnpm test:integration && pnpm test:e2e",
    "validate": "pnpm verify:local"
  },
  "devDependencies": {
    "@cce/agents": "workspace:*",
    "@cce/api-contracts": "workspace:*",
    "@cce/application": "workspace:*",
    "@cce/context-engine": "workspace:*",
    "@cce/conversation-import": "workspace:*",
    "@cce/database": "workspace:*",
    "@cce/domain": "workspace:*",
    "@cce/model-provider": "workspace:*",
    "@cce/mcp-server": "workspace:*",
    "@cce/shared": "workspace:*",
    "@cce/test-support": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11",
    "zod": "4.4.3"
  }
}
