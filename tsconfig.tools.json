{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "*.ts",
    "scripts/**/*.mts",
    "tests/**/*.ts",
    "packages/**/*.test.ts",
    "apps/**/*.test.ts",
    "apps/**/*.test.tsx"
  ],
  "exclude": ["node_modules", "**/.next/**", "**/dist/**"]
}
